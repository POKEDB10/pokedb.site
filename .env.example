# ============================================================
# pokedb.site — Environment Variables Configuration (.env)
# ============================================================

# 1. Google Safe Browsing API v4
# Real-time phishing, malware, and social engineering verdicts from Google
GOOGLE_SAFE_BROWSING_KEY=AIzaSyDexampleKey9027e4f9e6ee45a7ba8f

# 2. VirusTotal API v3
# Scans URLs & file hashes against 70+ antivirus engines (Kaspersky, Sophos, Bitdefender, etc.)
# Supports either variable name: VIRUSTOTAL_API_KEY or VT_API_KEY
VIRUSTOTAL_API_KEY=644b98ffa1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef
VT_API_KEY=644b98ffa1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef

# 3. URLScan.io API
# Live sandbox analysis and community threat scanning verdicts for website pages
URLSCAN_API_KEY=99a0b123-4567-89ab-cdef-0123456789ab

# 4. PhishTank API
# Real-time database lookup for active verified phishing URLs
PHISHTANK_API_KEY=a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef12345678

# 5. AbuseIPDB API v2
# Real-time IP address reputation & abuse confidence score lookup
ABUSEIPDB_API_KEY=80a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890abcdef12345678

# 6. Rootz Storage Gateway API (For Drop storage persistence)
SERVER_ROOTZ_KEY=rtz_live_a1b2c3d4e5f67890

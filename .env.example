# Server Port (Default 5050)
PORT=5050

# Custom Domain (Optional - auto-detects request domain if omitted)
BASE_URL=https://pokedb.site

# Rootz API Key (Required for 25 GB Drop Storage)
ROOTZ_API_KEY=YOUR_ROOTZ_API_KEY_HERE

# Storage-provider request timeout in milliseconds (default: 20 minutes)
ROOTZ_TIMEOUT_MS=1200000

# Optional default destination for direct uploads
ROOTZ_FOLDER_ID=YOUR_ROOTZ_FOLDER_ID
# ROOTZ_FOLDER_NAME=pokedb.site

# Large File Password (Required for uploads > 1 GB)
LARGE_FILE_PASSWORD=YOUR_LARGE_FILE_PASSWORD_HERE

# Redis Connection URL (Optional - defaults to persistent data/store.json)
REDIS_URL=redis://127.0.0.1:6379

# Redis password required by docker-compose
REDIS_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# Administrator token required to list Rootz account files
ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE
